<?php /* ペイントボタン */ ?>
<form action="<?php echo \htmlentities($self??'', ENT_QUOTES, 'UTF-8', false); ?>" method="post" enctype="multipart/form-data">
	<p>
 Width :<input name="picw" type="number" title="Width :" class="form" value="<?php echo \htmlentities($pdefw??'', ENT_QUOTES, 'UTF-8', false); ?>" min="300" max="<?php echo \htmlentities($pmaxw??'', ENT_QUOTES, 'UTF-8', false); ?>">
 Height :<input name="pich" type="number" title="Height" class="form" value="<?php echo \htmlentities($pdefh??'', ENT_QUOTES, 'UTF-8', false); ?>" min="300" max="<?php echo \htmlentities($pmaxh??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php if($select_app): ?>
 Tool:
 <select name="shi">
 <option value="neo">PaintBBS NEO</option>
 <?php if($use_shi_painter): ?><option value="1" class="for_pc">Shi-Painter</option><?php endif; ?>
 <?php if($use_chickenpaint): ?><option value="chicken">ChickenPaint</option><?php endif; ?>
 <?php if($use_klecks): ?><option value="klecks">Klecks</option><?php endif; ?>
	</select>
	<?php else: ?> 
	<?php /* <!-- 選択メニューを出さない時に起動するアプリ --> */ ?>
	<input type="hidden" name="shi" value="neo">
	<?php endif; ?>
	
 <?php if($use_select_palettes): ?>
 Palette：<select name="selected_palette_no" title="Palette" class="form"><?php echo $palette_select_tags; ?></select>
 <?php endif; ?>
 <?php if($resno): ?>
 <input type="hidden" name="resto" value="<?php echo \htmlentities($resno??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php endif; ?>
 <?php if($anime): ?><label><input type="checkbox" value="true" name="anime" title="Save Playback" <?php if($animechk): ?><?php echo \htmlentities($animechk??'', ENT_QUOTES, 'UTF-8', false); ?><?php endif; ?>>Save Playback</label><?php endif; ?>
 <input type="hidden" name="mode" value="paint">
 <input class="button" type="submit" value="Paint">
 <?php if($admin): ?>
 <input type="hidden" name="admin" value="<?php echo \htmlentities($admin??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <input name="pch_upload" type="file" accept="image/*,.pch,.spch,.chi,.psd" />
 <?php endif; ?>
	</p>
</form>
