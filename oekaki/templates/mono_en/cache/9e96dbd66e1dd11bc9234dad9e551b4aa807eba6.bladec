 <?php if(isset($oya) and !(empty($oya))): ?>
 <?php $__currentLoopData = $oya; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $i => $ress): $loop = $this->incrementLoopIndices();  ?>
 <?php $__currentLoopData = $ress; $this->addLoop($__currentLoopData);$this->getFirstLoop();
 foreach($__currentLoopData as $res): $loop = $this->incrementLoopIndices();  ?>
 <div>
 <?php if($res['imgsrc']): ?>
 <p><a href="<?php echo \htmlentities($self??'', ENT_QUOTES, 'UTF-8', false); ?>?res=<?php echo \htmlentities($res['no']??'', ENT_QUOTES, 'UTF-8', false); ?>" title="<?php echo \htmlentities($res['sub']??'', ENT_QUOTES, 'UTF-8', false); ?> by <?php echo \htmlentities($res['name']??'', ENT_QUOTES, 'UTF-8', false); ?>"><img
 src="<?php echo \htmlentities($res['imgsrc']??'', ENT_QUOTES, 'UTF-8', false); ?>" alt="<?php echo \htmlentities($res['sub']??'', ENT_QUOTES, 'UTF-8', false); ?> by <?php echo \htmlentities($res['name']??'', ENT_QUOTES, 'UTF-8', false); ?>" width="<?php echo \htmlentities($res['w']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 <?php if($res['h']): ?> height="<?php echo \htmlentities($res['h']??'', ENT_QUOTES, 'UTF-8', false); ?>" <?php endif; ?> <?php if($i>23): ?>loading="lazy"<?php endif; ?>></a></p>
 <?php endif; ?>
 <?php if($res['txt']): ?>
 <p><a href="<?php echo \htmlentities($self??'', ENT_QUOTES, 'UTF-8', false); ?>?res=<?php echo \htmlentities($res['no']??'', ENT_QUOTES, 'UTF-8', false); ?>"
 title="<?php echo \htmlentities($res['sub']??'', ENT_QUOTES, 'UTF-8', false); ?> by <?php echo \htmlentities($res['name']??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php echo \htmlentities($res['sub']??'', ENT_QUOTES, 'UTF-8', false); ?> by <?php echo \htmlentities($res['name']??'', ENT_QUOTES, 'UTF-8', false); ?></a></p>
 <?php endif; ?>
 <p>[<?php echo \htmlentities($res['no']??'', ENT_QUOTES, 'UTF-8', false); ?>] <?php echo \htmlentities($res['now']??'', ENT_QUOTES, 'UTF-8', false); ?><?php if($res['updatemark']): ?><?php echo \htmlentities($res['updatemark']??'', ENT_QUOTES, 'UTF-8', false); ?><?php endif; ?>
 <?php if($res['id']): ?> ID:<?php echo \htmlentities($res['id']??'', ENT_QUOTES, 'UTF-8', false); ?><?php endif; ?></p>
 </div>
 <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?> <?php endforeach; $this->popLoop(); $loop = $this->getFirstLoop(); ?>
