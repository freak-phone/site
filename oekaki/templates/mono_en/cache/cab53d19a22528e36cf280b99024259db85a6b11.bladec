<form class="delf" action="<?php echo \htmlentities($self??'', ENT_QUOTES, 'UTF-8', false); ?>" method="post">
	<?php if($notres): ?>
	<?php if($logfilename): ?><input type="hidden" name="logfilename" value="<?php echo \htmlentities($logfilename??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php endif; ?>
	<?php if($catalog_pageno): ?><input type="hidden" name="catalog_pageno" value="<?php echo \htmlentities($catalog_pageno??'', ENT_QUOTES, 'UTF-8', false); ?>"><?php endif; ?>
	<?php if($mode_catalog): ?><input type="hidden" name="mode_catalog" value="on"><?php endif; ?>
	<?php endif; ?>
	<?php if($resno): ?>
	<?php if($resno): ?><input type="hidden" name="thread_no" value="<?php if($oya[0][0]['no']): ?><?php echo \htmlentities($oya[0][0]['no']??'', ENT_QUOTES, 'UTF-8', false); ?><?php endif; ?>"><?php endif; ?>
	<?php endif; ?>
	<p>
 No <input class="form" type="number" min="1" name="del[]" value="" autocomplete="off">
 <span class="input_disp_none"><input type="text" value="" autocomplete="username"></span>
 Pass <input class="form" type="password" name="pwd" value="" autocomplete="current-password">
 <select class="form" name="mode">
 <option value="edit" selected>Edit</option>
 <?php if($userdel): ?>
 <option value="usrdel">Delete</option>
 <?php endif; ?>
 </select>
 <label>[<input type="checkbox" name="onlyimgdel" value="on">ImageOnly]</label>
 <input class="button" type="submit" value=" OK ">
 <span class="stylechanger">Style:
 <select class="form" id="mystyle" onchange="SetCss(this);">
 <option>MONO</option>
 <option>Dark</option>
 <option>Deep</option>
 <option>MAYO</option>
 <option>Orange</option>
 </select>
 </span>
	</p>
</form>
